# ---------- AI provider (server only; never prefix with NEXT_PUBLIC_) ----------
# "gemini" or "openai-compatible" (Groq, OpenRouter, OpenAI, local servers, ...)
AI_PROVIDER=gemini

# Gemini (Google AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# OpenAI-compatible provider (only used when AI_PROVIDER=openai-compatible)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---------- Optional web search (Tavily). Leave empty to hide the search toggle ----------
TAVILY_API_KEY=

# ---------- Usage limits (per signed-in user) ----------
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_LIMIT=100
DAILY_TTS_LIMIT=40
MAX_INPUT_CHARS=8000
MAX_HISTORY_MESSAGES=24
MAX_ATTACHMENT_MB=4
REQUEST_TIMEOUT_MS=60000

# ---------- Firebase Admin (server only) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences exactly as in the service-account JSON
FIREBASE_PRIVATE_KEY=

# ---------- Firebase web config (public by design; protected by Auth + Firestore rules) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
