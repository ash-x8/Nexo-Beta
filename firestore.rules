rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // Protected admin-controlled user fields cannot be forged or modified from client SDK
    function noProtectedUserKeys() {
      return !request.resource.data.keys().hasAny([
        'role', 'status', 'suspended', 'suspendedReason', 'disabled', 'featureOverrides'
      ]);
    }
    function protectedUserKeysUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'status', 'suspended', 'suspendedReason', 'disabled', 'featureOverrides'
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && noProtectedUserKeys()
        && request.resource.data.keys().size() <= 14
        && (!('displayName' in request.resource.data) || str(request.resource.data.displayName, 120))
        && (!('email' in request.resource.data) || str(request.resource.data.email, 200));
      allow update: if isOwner(uid)
        && protectedUserKeysUnchanged()
        && request.resource.data.keys().size() <= 20
        && (!('displayName' in request.resource.data) || str(request.resource.data.displayName, 120))
        && (!('email' in request.resource.data) || str(request.resource.data.email, 200));
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/conversations/{cid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && str(request.resource.data.title, 120)
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      match /messages/{mid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.role in ['user', 'assistant']
          && str(request.resource.data.content, 100000)
          && request.resource.data.createdAt is number;
      }
    }

    match /users/{uid}/memory/{mid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && str(request.resource.data.text, 300)
        && request.resource.data.createdAt is number
        && (!('enabled' in request.resource.data) || request.resource.data.enabled is bool);
    }

    match /users/{uid}/settings/{doc} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().size() <= 24;
      allow delete: if isOwner(uid);
    }

    // Usage counters are written only by the server (Admin SDK bypasses rules).
    match /users/{uid}/usage/{day} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Global runtime configuration & admin audit/security records are strictly server/Admin-SDK managed.
    match /system/{document=**} {
      allow read, write: if false;
    }
    match /admin/{document=**} {
      allow read, write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
